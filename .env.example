# Which provider the UI selects by default: groq | ollama | openai | anthropic
LLM_PROVIDER=groq

# --- Groq (free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama (free, local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Scoring ---
# Local multilingual embedding model (Sinhala + English), ~470 MB download on first run
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# How much each part counts towards the final score (must add up to 1.0)
SKILL_WEIGHT=0.6
SEMANTIC_WEIGHT=0.4
